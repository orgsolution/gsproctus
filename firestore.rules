rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if false;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if isValidId(postId);
      allow delete: if isValidId(postId);
    }

    // Direct Messages
    match /messages/{messageId} {
      allow read: if true;
      allow create, update: if isValidId(messageId);
      allow delete: if isValidId(messageId);
    }

    // Interactive games
    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isValidId(gameId);
      allow delete: if isValidId(gameId);
    }

    // Global configuration
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Specialties
    match /specialties/{specId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
